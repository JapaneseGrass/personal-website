---
import { withBase } from '../utils/url';

interface MediaItem {
  type: 'image' | 'video';
  src: string;
  alt?: string;
  poster?: string;
}

interface Props {
  media: MediaItem[];
  title: string;
}

const { media, title } = Astro.props;
---

<div class="media-gallery" aria-label={`Media for ${title}`}>
  {
    media.map((item) =>
      item.type === 'video' ? (
        <video
          class="media-item"
          controls
          preload="metadata"
          playsinline
          poster={item.poster ? withBase(item.poster) : undefined}
        >
          <source src={withBase(item.src)} />
          Your browser doesn’t support embedded video.
        </video>
      ) : (
        <a
          class="media-item media-image-link"
          href={withBase(item.src)}
          target="_blank"
          rel="noopener"
          aria-label={item.alt ?? `${title} photo`}
        >
          <img src={withBase(item.src)} alt={item.alt ?? `${title} photo`} loading="lazy" />
        </a>
      )
    )
  }
</div>

<style>
  .media-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.6rem;
    margin: 0.25rem 0 1rem;
  }
  .media-item {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 0.6rem;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    object-fit: cover;
    display: block;
  }
  .media-image-link {
    overflow: hidden;
    line-height: 0;
  }
  .media-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }
  .media-image-link:hover img {
    transform: scale(1.05);
  }
  video.media-item {
    object-fit: cover;
    background: #000;
  }
</style>
